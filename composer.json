{
    "name": "digigrow/aiassistant",
    "description": "AI-powered reply drafting with customer context learning for FreeScout",
    "authors": [
        {
            "name": "DigiGrow LTD",
            "email": "support@digigrow.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\AIAssistant\\Providers\\AIAssistantServiceProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\AIAssistant\\": ""
        }
    },
    "require": {
        "tectalic/openai": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "replace": {
        "guzzlehttp/guzzle": "*",
        "guzzlehttp/promises": "*",
        "guzzlehttp/psr7": "*",
        "psr/http-message": "*"
    }
}
